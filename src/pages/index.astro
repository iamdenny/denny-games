---
import Base from "../layouts/Base.astro";
---

<Base
  locale="en"
  root
  title="A quick break. A good game."
  description="Free browser games in English and Korean. No installation or account required."
>
  <script is:inline slot="head">
    const languages = navigator.languages?.length
      ? navigator.languages
      : [navigator.language];
    const locale =
      languages
        .map((language) => language.toLowerCase().split("-")[0])
        .find((language) => language === "ko" || language === "en") || "en";
    location.replace(`/${locale}/${location.search}${location.hash}`);
  </script>
  <section class="root-choice">
    <p class="eyebrow">A QUICK BREAK. A GOOD GAME.</p>
    <h1>
      Your little
      <br />
      arcade awaits.
    </h1>
    <p>
      Free browser games. Pick your language.
      <br />
      <span lang="ko">설치 없는 무료 웹게임. 언어를 선택하세요.</span>
    </p>
    <div class="detail-actions">
      <a class="button primary" href="/en/" lang="en">
        Play in English ↗
      </a>
      <a class="button secondary" href="/ko/" lang="ko">
        한국어로 플레이 ↗
      </a>
    </div>
  </section>
</Base>
