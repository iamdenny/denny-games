        <input
          id="search-query"
          name="q"
          type="search"
          aria-label={text.search}
          placeholder={text.search}
          maxlength="120"
        />
        <fieldset>
          <legend>{label("Narrow your search", "조건으로 찾기")}</legend>
          <label>
            {label("Category", "장르")}
            <select name="category">
              <option value="">{label("All categories", "전체 장르")}</option>
              {categories.map((category) => (
                <option value={category}>{text[category]}</option>
              ))}
            </select>
          </label>
          <label>
            {label("Play style", "플레이 방식")}
            <select name="control">
              <option value="">
                {label("All play styles", "모든 플레이 방식")}
              </option>
              {controlStyles.map((style) => (
                <option value={style}>{controlLabels[style][locale]}</option>
              ))}
            </select>
          </label>
          <label>
            {label("Estimated round", "예상 한 판 길이")}
            <select name="length">
              <option value="">{label("Any length", "모든 길이")}</option>
              <option value="short">
                {label("Up to 3 minutes", "3분 이내")}
              </option>
              <option value="long">
                {label("Over 3 minutes", "3분 초과")}
              </option>
            </select>
          </label>
        </fieldset>
        <p class="notice">
          {label(
            "Round lengths are estimates. Play style describes controls, not verified device support.",
            "한 판 길이는 예상치입니다. 플레이 방식은 조작 구분이며 기기 호환성 인증이 아닙니다.",
          )}
        </p>
        <div class="detail-actions">
          <button type="submit">{text.searchAction}</button>
          <button type="reset">{label("Clear filters", "조건 초기화")}</button>
