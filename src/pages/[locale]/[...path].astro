        <p>{collectionCopy.criteria}</p>
        <h2>{collectionCopy.question}</h2>
        <p>{collectionCopy.answer}</p>
        <p class="notice">{text.deviceNotice}</p>
        <p>
          <a href={`/${locale}/device-check/`}>
            {label("Check your device", "내 기기에서 점검하기")} ↗
