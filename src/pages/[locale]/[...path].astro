      </p>
      <pre id="diagnostic" class="diagnostic" aria-live="off"></pre>
      <button id="touch-test" class="touch-test" type="button">
        {label("Tap to test touch / click", "터치·클릭을 시험해보세요")}
      </button>
      <p id="touch-result" role="status"></p>
      <button id="diagnostic-sound" type="button">
        {label("Test sound", "소리 시험")}
      </button>
    </div>
  )}
  {kind === "guides" && path === "guides" && (
    <>
      <div class="page-heading">
        <span class="eyebrow">{text.guides}</span>
        <h1>{label("A smoother next round.", "다음 한 판은 더 편하게.")}</h1>
        <p>
          {label(
            "Simple notes on controls, sound and saving.",
            "조작·소리·저장을 위한 짧은 안내입니다.",
          )}
        </p>
      </div>
      <div class="notes-grid">
        {guidePaths.map((p, i) => (
          <article class="note-card">
            <span class="eyebrow">0{i + 1}</span>
            <h2>{articles[p]![locale].title}</h2>
            <p>{articles[p]![locale].intro}</p>
            <a href={`/${locale}/${p}/`}>{label("Read note", "노트 읽기")} ↗</a>
          </article>
        ))}
      </div>
    </>
  )}
  {article && (
    <article class="prose">
      <div class="page-heading">
        <span class="eyebrow">DENNY GAMES / {text.guides}</span>
        <h1>{article.title}</h1>
        <p>{article.intro}</p>
      </div>
      <nav class="breadcrumb" aria-label={label("Breadcrumb", "현재 위치")}>
        <a href={`/${locale}/`}>{text.home}</a>
        <span>/ {article.title}</span>
      </nav>
      {article.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </section>
      ))}
      {article.links && (
        <section>
          <h2>{label("Sources and next steps", "출처와 다음 단계")}</h2>
          <ul>
            {article.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {path === "contact" && (
        <p>
          <a
            class="button primary"
            href="https://github.com/iamdenny/denny-games/issues/new"
          >
            GitHub ↗
          </a>
        </p>
      )}
      {["tesla", "controller-games"].includes(path) && (
        <p>
          <a class="button" href={`/${locale}/gamepad-test/`}>
            {text.gamepad} ↗
          </a>
        </p>
      )}
      {path.startsWith("guides/") && <AdSlot id="guide-body" locale={locale} />}
    </article>
  )}
  {kind === "licenses" && (
    <div class="prose">
      <div class="page-heading">
        <h1>{text.licenseTitle}</h1>
        <p>
          {label(
            "Game authors and license notices are part of the experience.",
            "제작자와 라이선스 고지를 함께 제공합니다.",
          )}
        </p>
      </div>
      {games.map((g) => (
        <section>
          <h2>{g.text[locale].title}</h2>
          <p>
            {g.author} · {g.license}
          </p>
          <p>
            <a href={g.source}>{text.source}</a>
            {g.imported && (
              <>
                <span> · </span>
                <a href="/licenses/crisp/">MIT notices / pinned sources</a>
              </>
            )}
            {g.id === "2048" && (
              <>
                {" "}
                · <a href="/licenses/2048.txt">MIT notice / upstream commit</a>
              </>
            )}
          </p>
        </section>
      ))}
      <p>
        <a href="https://github.com/iamdenny/denny-games/blob/main/LICENSE">
          Denny Games MIT
        </a>{" "}
        ·{" "}
        <a href="/licenses/dependencies.json">
          {label("Dependency notices", "의존성 라이선스")}
        </a>
      </p>
    </div>
  )}
</Base>

<script>
  if (document.querySelector("#search-query"))
    void import("../../scripts/search");
  if (document.querySelector("#diagnostic"))
    void import("../../scripts/diagnostic");
</script>
