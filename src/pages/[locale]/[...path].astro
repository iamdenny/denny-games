                class="button primary daily-play"
                data-daily={g.id}
                href={`/${locale}/play/${g.id}/?daily=1`}
              >
                {text.daily} ↗
              </a>
            </article>
          ))}
      </div>
      <p class="notice">{text.dailyNote}</p>
    </>
  )}
  {kind === "search" && (
