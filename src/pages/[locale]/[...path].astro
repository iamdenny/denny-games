  {kind === "licenses" && (
    <div class="prose">
      <div class="page-heading">
        <h1>{text.licenseTitle}</h1>
        <p>
          {label(
            "Game authors and license notices are part of the experience.",
            "제작자와 라이선스 고지를 함께 제공합니다.",
          )}
        </p>
      </div>
      {games.map((g) => (
        <section>
          <h2>{g.text[locale].title}</h2>
          <p>
            {g.author} · {g.license}
          </p>
          <p>
            <a href={g.source}>{text.source}</a>
            {g.licenseUrl && (
              <>
                <span> · </span>
                <a
                  href={g.licenseUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {label("License details", "라이선스 안내")}
                </a>
              </>
            )}
            {g.externalPlay && (
              <>
                <span> · </span>
                <a
                  href={g.externalPlay.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {text.externalLabel}: {g.externalPlay.host[locale]}
                </a>
              </>
            )}
            {g.imported && g.notice && (
              <>
                <span> · </span>
                <a href={g.notice}>
                  {g.id === "bounce-back"
                    ? label(
                        "GPL-2.0-or-later source",
                        "GPL-2.0-or-later 대응 소스",
                      )
                    : label(
                        "MIT notices / pinned sources",
                        "MIT 고지 / 고정 소스",
                      )}
                </a>
              </>
            )}
            {g.id === "2048" && (
              <>
                {" "}
                · <a href="/licenses/2048.txt">MIT notice / upstream commit</a>
              </>
            )}
          </p>
        </section>
      ))}
      <p>
        <a href="https://github.com/iamdenny/denny-games/blob/main/LICENSE">
          Denny Games MIT
        </a>{" "}
        ·{" "}
        <a href="/licenses/dependencies.json">
          {label("Dependency notices", "의존성 라이선스")}
        </a>
      </p>
    </div>
  )}
</Base>

<script>
  if (document.querySelector("#search-query"))
    void import("../../scripts/search");
  if (document.querySelector("#diagnostic"))
    void import("../../scripts/diagnostic");
</script>
