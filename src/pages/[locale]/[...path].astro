---
import Base from "../../layouts/Base.astro";
import GameCard from "../../components/GameCard.astro";
import { editorialOrder } from "../../data/editorial";
import CataloguePages from "../../components/CataloguePages.astro";
import AdSlot from "../../components/AdSlot.astro";
import AffiliateCard from "../../components/AffiliateCard.astro";
import CollectionLinks from "../../components/CollectionLinks.astro";
import DeviceCheck from "../../components/DeviceCheck.astro";
import {
  collections,
  collectionGames,
  controlLabels,
  controlStyles,
} from "../../data/collections";
import Player from "../../components/Player.astro";
import { games, categories, categoryGames, gameById } from "../../data/games";
import { articles, guidePaths } from "../../data/pages";
import { locales, t } from "../../data/i18n";
import { pagePaths, indexable } from "../../lib/routes";
import { paginate, PAGE_SIZE } from "../../lib/catalogue";
import { categoryCopy } from "../../data/discovery";
import { discoverySchema } from "../../lib/seo";
import type { Category } from "../../data/games";
import type { Locale } from "../../lib/types";
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    pagePaths().map((path) => ({
      params: { locale, path: path || undefined },
    })),
  );
}
const locale = Astro.params.locale as Locale;
const path = Astro.params.path ?? "";
const text = t(locale);
const parts = path.split("/");
const kind = parts[0];
const isHome = !path;
const isAll = kind === "all";
const isPlay = kind === "play";
const game = ["games", "play"].includes(kind ?? "")
  ? gameById(parts[1]!)
  : undefined;
const category = parts[1];
const page = Number((isAll ? parts[2] : parts[3]) ?? "1");
const totalPages = Math.ceil(games.length / PAGE_SIZE);
const recommended = editorialOrder(games);
const homeCuratedPreviewCount = 6;
const homeCategoryPreviewCount = 3;
const featured = recommended[0]!;
const pageSuffix =
  page > 1 ? (locale === "ko" ? ` · ${page}페이지` : ` · Page ${page}`) : "";
const gameCollection =
  kind === "collections"
    ? collections.find((item) => item.id === parts[1])
    : undefined;
const collectionCopy = gameCollection?.text[locale];
const article = articles[path]?.[locale];
const collection =
  kind === "category"
    ? paginate(categoryGames(category!), page)
    : isAll
      ? paginate(recommended, page)
      : games;
const title = isHome
  ? locale === "ko"
    ? "설치 없이 즐기는 무료 웹게임"
    : "Free games. Right in your browser."
  : game
    ? `${game.text[locale].title} · ${locale === "ko" ? "무료 웹게임" : "Play Free Online"}`
    : (collectionCopy?.title ??
      article?.title ??
      {
        all: `${text.all} · ${games.length}${locale === "ko" ? "개 무료 웹게임" : " free browser games"}${pageSuffix}`,
        category: `${text[category as Category]} ${locale === "ko" ? "무료 웹게임" : "Free Browser Games"}${page > 1 ? (locale === "ko" ? ` · ${page}페이지` : ` · Page ${page}`) : ""}`,
        collections:
          locale === "ko"
            ? "플레이 방식별 무료 웹게임 모음"
            : "Free browser game collections by play style",
        "device-check":
          locale === "ko" ? "내 기기에서 점검하기" : "Check your device",
        daily: text.daily,
        search: text.searchAction,
        library: text.library,
        compatibility: text.compatibility,
        "gamepad-test": text.gamepad,
        guides: text.guides,
        licenses: text.licenseTitle,
      }[kind!] ??
      text.all);
const categoryIntro =
  kind === "category" ? categoryCopy[category as Category][locale] : undefined;
const description =
  (isAll
    ? locale === "ko"
      ? `무료 웹게임 전체 ${games.length}개 중 ${(page - 1) * PAGE_SIZE + 1}–${Math.min(page * PAGE_SIZE, games.length)}번째 게임입니다. ${page}/${totalPages}페이지에서 게임을 고르거나 퍼즐·아케이드·액션·슈팅·레이싱·스포츠 목록으로 이동하세요.`
      : `Browse games ${(page - 1) * PAGE_SIZE + 1}–${Math.min(page * PAGE_SIZE, games.length)} of all ${games.length} free browser games. Page ${page} of ${totalPages}, with board, puzzle, arcade, action, shooting, racing and sports categories.`
    : undefined) ??
  collectionCopy?.intro ??
  (path === "collections"
    ? locale === "ko"
      ? "한 버튼, 위치 조작, 숫자 퍼즐과 일일 도전으로 무료 웹게임을 골라보세요. 실제 조작 기준과 저장·기기 검증 제한을 함께 안내합니다."
      : "Choose free browser games by one-button controls, pointer play, number puzzles or daily challenges. Read selection criteria, save limits and device-testing boundaries."
    : undefined) ??
  game?.text[locale].description ??
  article?.intro ??
  (categoryIntro
    ? `${categoryIntro} ${locale === "ko" ? `${page}페이지 · 총 ${categoryGames(category!).length}개 게임.` : `Page ${page} · ${categoryGames(category!).length} games in this collection.`}`
    : isHome
      ? locale === "ko"
        ? `가입·설치 없이 즐기는 ${games.length}개 무료 웹게임. 퍼즐, 아케이드, 액션, 슈팅, 레이싱과 스포츠를 게임별 규칙·조작 안내와 함께 만나세요.`
        : `Play ${games.length} free browser games without an account or installation. Explore puzzles, arcade, action, shooting, racing and sports with rules and controls.`
      : `${title}. ${text.tagline}`);
const schema = indexable(path)
  ? discoverySchema({
      locale,
      path,
      title,
      description,
      game: isPlay ? undefined : game,
      items:
        kind === "category" || isAll
          ? collection
          : gameCollection
            ? collectionGames(gameCollection.id)
            : undefined,
    })
  : undefined;
const label = (en: string, ko: string) => (locale === "ko" ? ko : en);
---

<Base
  locale={locale}
  title={title}
  description={description}
  path={path}
  noindex={!indexable(path)}
  play={isPlay}
  schema={schema}
  image={game ? (game.screenshot ?? game.artwork) : undefined}
>
  {isHome && (
    <>
      <section class="home-intro">
        <div>
          <p class="eyebrow">{text.tagline}</p>
          <h1>{text.title}</h1>
        </div>
        <form
          action={`/${locale}/search/`}
          class="search-form home-search"
          role="search"
        >
          <input
            type="search"
            name="q"
            aria-label={text.search}
            placeholder={text.search}
          />
          <button type="submit" aria-label={text.searchAction}>
            ⌕
          </button>
        </form>
      </section>
      <p class="notice">
        {description}{" "}
        <a href={`/${locale}/guides/open-browser-games/`}>
          {label("Sources and device support", "출처와 기기 지원 안내")} ↗
        </a>
      </p>
      <div class="catalogue-entry">
        <a class="button primary" href={`/${locale}/all/`}>
          {label(
            `Browse all ${games.length} games`,
            `전체 ${games.length}개 게임 보기`,
          )}{" "}
          ↗
        </a>
        <p>
          {label(
            "A selection appears below. Open the full catalogue to browse every game, 24 per page.",
            "아래는 추천과 장르별 미리보기입니다. 전체 목록에서는 모든 게임을 24개씩 볼 수 있어요.",
          )}
        </p>
      </div>
      <CollectionLinks locale={locale} />
      <section class="feature">
        <div class="feature-copy">
          <span class="eyebrow">{text.featured}</span>
          <h2>{featured.text[locale].title}</h2>
          <p>{featured.text[locale].description}</p>
          <a href={`/${locale}/games/${featured.id}/`} class="button primary">
            {text.details}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <a
          class="feature-image"
          href={`/${locale}/games/${featured.id}/`}
          aria-label={featured.text[locale].title}
        >
          <img
            src={featured.artwork}
            width="640"
            height="400"
            alt=""
            fetchpriority="high"
          />
        </a>
      </section>
      <section data-curated-preview-count={homeCuratedPreviewCount}>
        <div class="section-heading">
          <h2>{text.curated}</h2>
          <span class="count">{label("6 editor picks", "추천 게임 6개")}</span>
        </div>
        <p class="editorial-note">
          {label(
            "Selected for screen clarity and approachable rules. Editor picks are not a popularity chart.",
            "화면이 읽기 쉽고 규칙이 분명한 게임을 먼저 골랐어요. 이용자 인기 순위는 아닙니다.",
          )}
        </p>
        <div class="game-grid">
          {recommended.slice(0, homeCuratedPreviewCount).map((game) => (
            <GameCard game={game} locale={locale} />
          ))}
        </div>
      </section>
      {categories.map((category) => (
        <section
          class="catalogue-section"
          data-game-count={categoryGames(category).length}
          data-preview-limit={homeCategoryPreviewCount}
        >
          <div class="section-heading">
            <h2>
              {text[category]}{" "}
              <span class="count">{categoryGames(category).length}</span>
            </h2>
            <a class="button" href={`/${locale}/category/${category}/`}>
              {label("View all", "전체 보기")} ↗
            </a>
          </div>
          <div class="game-grid">
            {categoryGames(category)
              .slice(0, homeCategoryPreviewCount)
              .map((g) => (
                <GameCard game={g} locale={locale} />
              ))}
          </div>
        </section>
      ))}
      <section class="daily-banner">
        <div>
          <span class="eyebrow">{text.dailyLabel}</span>
          <h2>{text.dailyTitle}</h2>
          <p>{text.dailyNote}</p>
        </div>
        <a class="button primary" href={`/${locale}/daily/`}>
          {text.daily} ↗
        </a>
      </section>
      <AdSlot id="home-mid" locale={locale} />
      <AffiliateCard locale={locale} />
      <section class="notes-grid">
        <article class="note-card">
          <span class="eyebrow">01 / {text.guides}</span>
          <h3>
            {label("Make the controller feel at home.", "패드로 더 편안하게.")}
          </h3>
          <p>
            {label(
              "One mapping, from the menu to the next round. See the current support boundaries.",
              "메뉴부터 다음 한 판까지 같은 조작. 현재 지원 범위를 확인하세요.",
            )}
          </p>
          <a href={`/${locale}/controller-games/`}>{text.controls} ↗</a>
        </article>
        <article class="note-card">
          <span class="eyebrow">02 / {text.compatibility}</span>
          <h3>
            {label("Big screen. Clear expectations.", "큰 화면, 분명한 안내.")}
          </h3>
          <p>
            {label(
              "Touch first. Parked only. Physical vehicle results are still pending.",
              "터치부터, 주차 중에만. 실차 결과는 아직 검증 전입니다.",
            )}
          </p>
          <a href={`/${locale}/tesla/`}>{text.compatibility} ↗</a>
        </article>
      </section>
    </>
  )}
  {game && kind === "games" && (
    <>
      <nav class="breadcrumb" aria-label={label("Breadcrumb", "현재 위치")}>
        <a href={`/${locale}/`}>{text.home}</a>
        <span>/</span>
        <a href={`/${locale}/category/${game.category}/`}>
          {text[game.category]}
        </a>
        <span>/ {game.text[locale].title}</span>
      </nav>
      <section class="detail-hero">
        <div>
          <span class="eyebrow">
            {text[game.category]} / {game.duration} {text.minutes}
          </span>
          <h1>{game.text[locale].title}</h1>
          <p>{game.text[locale].description}</p>
          <div class="detail-actions">
            <a class="button primary" href={`/${locale}/play/${game.id}/`}>
              {text.play} ↗
            </a>
            <button data-favorite={game.id} aria-pressed="false" type="button">
              ♡ {text.favorite}
            </button>
          </div>
          <div class="badges">
            <span class="badge">{text.touch}</span>
            <span class="badge">{text.keyboard}</span>
            <span class="badge">{text.pad}</span>
          </div>
        </div>
        <img
          src={game.artwork}
          width="640"
          height="400"
          alt={`${game.text[locale].title} — ${game.imported ? label("actual game preview", "실제 게임 화면") : label("original illustration", "게임 일러스트")}`}
        />
      </section>
      <div class="prose">
        {game.screenshot && (
          <figure class="game-screenshot">
            <img
              src={game.screenshot}
              width="640"
              height="640"
              loading="lazy"
              alt={`${game.text[locale].title} — ${label("actual game board", "실제 게임 화면")}`}
            />
            <figcaption>
              {label(
                "Actual game board · Chromium",
                "실제 게임 화면 · Chromium",
              )}
            </figcaption>
          </figure>
        )}
        <section>
          <h2>{text.rules}</h2>
          <ol>
            {game.text[locale].rules.map((rule) => (
              <li>{rule}</li>
            ))}
          </ol>
        </section>
        {game.classic && (
          <section>
            <h2>{label("AI or a friend?", "AI 또는 친구와 한 판")}</h2>
            <p>
              {label(
                "Choose local AI with three search levels, or two players sharing one device. Changing mode or level starts a fresh game. Select a space, then confirm your move. There are no online rooms.",
                "세 난이도의 로컬 AI 또는 같은 기기 2인 모드를 고르세요. 방식·난이도 변경은 새 대국을 시작합니다. 칸을 선택한 뒤 수를 확정하세요. 온라인 대전 방은 없습니다.",
              )}
            </p>
            <a href={`/${locale}/guides/classic-board-games/`}>
              {label(
                "Compare rules, controls and local saves",
                "규칙·조작·저장 방식 비교하기",
              )}{" "}
              ↗
            </a>
          </section>
        )}
        <section>
          <h2>{text.controls}</h2>
          <ul>
            {game.text[locale].controls.map((control) => (
              <li>{control}</li>
            ))}
          </ul>
        </section>
        <section>
          <h2>{text.tips}</h2>
          <ul>
            {game.text[locale].tips.map((tip) => (
              <li>{tip}</li>
            ))}
          </ul>
        </section>
        <section>
          <h2>{text.support}</h2>
          <p>{text.deviceNotice}</p>
          <p>
            {label("Play style", "플레이 방식")}:{" "}
            {controlLabels[game.controlStyle][locale]}.{" "}
            {game.imported
              ? label(
                  "Original in-game text is English. Leaving or changing language restarts the round; personal bests remain local.",
                  "게임 내부 원본 문자는 영어입니다. 이탈·언어 변경 시 라운드가 재시작되며 최고 점수는 로컬에 남습니다.",
                )
              : label(
                  "Local progress restoration is available for this game.",
                  "이 게임은 로컬 진행 상태 복원을 지원합니다.",
                )}
          </p>
          <p>
            <a href={`/${locale}/device-check/?game=${game.id}`}>
              {label(
                "Check this game on your device",
                "내 기기에서 이 게임 점검하기",
              )}{" "}
              ↗
            </a>
          </p>
          <p>
            <a href={`/${locale}/compatibility/`}>{text.compatibility}</a> ·{" "}
            <a href={`/${locale}/gamepad-test/`}>{text.gamepad}</a>
          </p>
        </section>
        <section>
          <h2>{text.credit}</h2>
          <p>
            {game.author} · {game.license}.{" "}
            {game.imported && (
              <a href="/licenses/crisp/">MIT notices / 출처 고지 · </a>
            )}
            <a href={game.source}>{text.source}</a>
          </p>
          <p>
            {label("Updated", "갱신일")}: {game.added}. {text.noAds}
          </p>
        </section>
        <AdSlot id="detail-body" locale={locale} />
        <AffiliateCard locale={locale} />
      </div>
      <CollectionLinks locale={locale} gameId={game.id} />
      <section>
        <div class="section-heading">
          <h2>{label("Next little escape", "다음 작은 즐거움")}</h2>
        </div>
        <div class="game-grid">
          {games
            .filter((g) => g.id !== game.id && g.category === game.category)
            .slice(0, 3)
            .map((g) => (
              <GameCard game={g} locale={locale} />
            ))}
        </div>
      </section>
    </>
  )}
  {game && isPlay && <Player game={game} locale={locale} />}
  {kind === "category" && (
    <>
      <div class="page-heading">
        <span class="eyebrow">
          {text.all} / {page}
        </span>
        <h1>{title}</h1>
        <p>{categoryIntro}</p>
      </div>
      <div class="toolbar">
        <label>
          {text.sort}
          <select data-sort>
            <option value="recommended">{text.recommended}</option>
            <option value="name">{text.az}</option>
            <option value="newest">{text.newest}</option>
          </select>
        </label>
        <label>
          {text.filter}
          <select data-input-filter>
            <option value="any">{text.any}</option>
            <option value="touch">{text.touch}</option>
            <option value="keyboard">{text.keyboard}</option>
            <option value="gamepad">{text.pad}</option>
          </select>
        </label>
        <span class="count">
          {categoryGames(category!).length} {text.available}
        </span>
      </div>
      <div class="game-grid" data-sort-grid data-category={category}>
        {collection.map((g) => (
          <GameCard game={g} locale={locale} />
        ))}
      </div>
      {categoryGames(category!).length > PAGE_SIZE && (
        <nav
          class="pagination"
          data-pagination
          aria-label={label("Pages", "페이지")}
        >
          {Array.from(
            { length: Math.ceil(categoryGames(category!).length / PAGE_SIZE) },
            (_, i) => (
              <a
                href={`/${locale}/category/${category}${i ? "/page/" + (i + 1) : ""}/`}
                aria-current={page === i + 1 ? "page" : undefined}
              >
                {i + 1}
              </a>
            ),
          )}
        </nav>
      )}
      <AdSlot id="category-mid" locale={locale} />
    </>
  )}
  {isAll && (
    <>
      <div class="page-heading">
        <span class="eyebrow">
          {label("THE COMPLETE CATALOGUE", "빠짐없이, 전체 목록")}
        </span>
        <h1>
          {text.all}
          {pageSuffix}
        </h1>
        <p>
          {label(
            `Every published game is here, ${PAGE_SIZE} per page. Collections are curated selections; this catalogue includes all ${games.length} games.`,
            `공개된 ${games.length}개 게임을 빠짐없이 ${PAGE_SIZE}개씩 보여드립니다. 선별된 게임 모음과 달리 모든 게임을 포함합니다.`,
          )}
        </p>
        <p class="editorial-note">
          {label(
            "Editor picks appear first, based on screen clarity and game rules. This is an editorial selection, not a player popularity ranking.",
            "화면의 가독성과 게임 규칙을 기준으로 고른 에디터 픽을 먼저 보여드립니다. 이용자 인기 순위는 아닙니다.",
          )}
        </p>
      </div>
      <nav
        class="catalogue-categories"
        aria-label={label("Choose a category", "장르 선택")}
      >
        <a class="button" href={`/${locale}/all/`} aria-current="page">
          {text.all} · {games.length}
        </a>
        {categories.map((c) => (
          <a class="button" href={`/${locale}/category/${c}/`}>
            {text[c]} · {categoryGames(c).length}
          </a>
        ))}
      </nav>
      <div class="catalogue-summary">
        <p data-catalogue-range>
          {label(
            `Showing ${(page - 1) * PAGE_SIZE + 1}–${Math.min(page * PAGE_SIZE, games.length)} of ${games.length} games · Page ${page} of ${totalPages}`,
            `전체 ${games.length}개 중 ${(page - 1) * PAGE_SIZE + 1}–${Math.min(page * PAGE_SIZE, games.length)}개 표시 · ${page}/${totalPages}페이지`,
          )}
        </p>
        <a class="button" href={`/${locale}/search/`}>
          {label("Search & filter", "검색·조건으로 찾기")} ↗
        </a>
      </div>
      <CataloguePages
        locale={locale}
        page={page}
        total={totalPages}
        placement="top"
      />
      <div class="game-grid" data-all-games>
        {collection.map((g) => (
          <GameCard game={g} locale={locale} />
        ))}
      </div>
      <CataloguePages
        locale={locale}
        page={page}
        total={totalPages}
        placement="bottom"
      />
    </>
  )}
  {kind === "device-check" && <DeviceCheck locale={locale} />}
  {kind === "collections" && !gameCollection && (
    <>
      <div class="page-heading">
        <span class="eyebrow">DENNY GAMES / COLLECTIONS</span>
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      <CollectionLinks locale={locale} />
      <p class="notice">{text.deviceNotice}</p>
    </>
  )}
  {gameCollection && collectionCopy && (
    <>
      <nav class="breadcrumb" aria-label={label("Breadcrumb", "현재 위치")}>
        <a href={`/${locale}/`}>{text.home}</a>
        <span>/</span>
        <a href={`/${locale}/collections/`}>
          {label("Collections", "게임 모음")}
        </a>
        <span>/ {collectionCopy.title}</span>
      </nav>
      <div class="page-heading">
        <span class="eyebrow">
          {collectionGames(gameCollection.id).length} {text.available}
        </span>
        <h1>{title}</h1>
        <p>{collectionCopy.intro}</p>
      </div>
      <div class="game-grid">
        {collectionGames(gameCollection.id).map((game) => (
          <GameCard game={game} locale={locale} />
        ))}
      </div>
      <div class="prose">
