---
import Base from "../../layouts/Base.astro";
import GameCard from "../../components/GameCard.astro";
import AdSlot from "../../components/AdSlot.astro";
import Player from "../../components/Player.astro";
import { games, categories, categoryGames, gameById } from "../../data/games";
import { articles, guidePaths } from "../../data/pages";
import { locales, t } from "../../data/i18n";
import { pagePaths, indexable } from "../../lib/routes";
import { paginate, PAGE_SIZE } from "../../lib/catalogue";
import type { Locale } from "../../lib/types";
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    pagePaths().map((path) => ({
      params: { locale, path: path || undefined },
    })),
  );
}
const locale = Astro.params.locale as Locale;
const path = Astro.params.path ?? "";
const text = t(locale);
const parts = path.split("/");
const kind = parts[0];
const isHome = !path;
const isPlay = kind === "play";
const game = ["games", "play"].includes(kind ?? "")
  ? gameById(parts[1]!)
  : undefined;
const category = parts[1];
const page = Number(parts[3] ?? "1");
const article = articles[path]?.[locale];
const collection =
  kind === "category" ? paginate(categoryGames(category!), page) : games;
const title = isHome
  ? locale === "ko"
    ? "설치 없이 즐기는 무료 웹게임"
    : "Free games. Right in your browser."
  : game
    ? game.text[locale].title
    : (article?.title ??
      {
        category: text[category as (typeof categories)[number]],
        daily: text.daily,
        search: text.searchAction,
        library: text.library,
        compatibility: text.compatibility,
        "gamepad-test": text.gamepad,
        guides: text.guides,
        licenses: text.licenseTitle,
      }[kind!] ??
      text.all);
const description =
  game?.text[locale].description ??
  article?.intro ??
  (isHome ? text.intro : `${title}. ${text.tagline}`);
const schema =
  game && !isPlay
    ? {
        "@context": "https://schema.org",
        "@type": "VideoGame",
        name: game.text[locale].title,
        description,
        url: `https://games.iamdenny.com/${locale}/games/${game.id}/`,
        image: `https://games.iamdenny.com${game.artwork}`,
        inLanguage: locale,
        gamePlatform: "Web browser",
        playMode: "SinglePlayer",
        isAccessibleForFree: true,
        author: { "@type": "Person", name: game.author },
        license: "https://opensource.org/license/mit",
      }
    : undefined;
const label = (en: string, ko: string) => (locale === "ko" ? ko : en);
---

<Base
  locale={locale}
  title={title}
  description={description}
  path={path}
  noindex={!indexable(path)}
  play={isPlay}
  schema={schema}
>
  {isHome && (
    <>
      <section class="home-intro">
        <div>
          <p class="eyebrow">{text.tagline}</p>
          <h1>{text.title}</h1>
        </div>
        <form
          action={`/${locale}/search/`}
          class="search-form home-search"
          role="search"
        >
          <input
            type="search"
            name="q"
            aria-label={text.search}
            placeholder={text.search}
          />
          <button type="submit" aria-label={text.searchAction}>
            ⌕
          </button>
        </form>
      </section>
      <section class="feature">
        <div class="feature-copy">
          <span class="eyebrow">{text.featured}</span>
          <h2>{games[0]!.text[locale].title}</h2>
          <p>{games[0]!.text[locale].description}</p>
          <a href={`/${locale}/games/${games[0]!.id}/`} class="button primary">
            {text.details}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <a
          class="feature-image"
          href={`/${locale}/games/${games[0]!.id}/`}
          aria-label={games[0]!.text[locale].title}
        >
          <img
            src={games[0]!.artwork}
            width="640"
            height="400"
            alt=""
            fetchpriority="high"
          />
        </a>
      </section>
      <section>
        <div class="section-heading">
          <h2>{text.curated}</h2>
          <span class="count">
            {games.length} {text.available}
          </span>
        </div>
        <div class="game-grid">
          {games.slice(0, 3).map((game) => (
            <GameCard game={game} locale={locale} />
          ))}
        </div>
      </section>
      {categories.map((category) => (
        <section class="catalogue-section">
          <div class="section-heading">
            <h2>
              {text[category]}{" "}
              <span class="count">{categoryGames(category).length}</span>
            </h2>
            <a class="button" href={`/${locale}/category/${category}/`}>
              {label("View all", "전체 보기")} ↗
            </a>
          </div>
          <div class="game-grid">
            {categoryGames(category)
              .filter((g) => g.imported)
              .slice(0, 3)
              .map((g) => (
                <GameCard game={g} locale={locale} />
              ))}
          </div>
        </section>
      ))}
      <section class="daily-banner">
        <div>
          <span class="eyebrow">{text.dailyLabel}</span>
          <h2>{text.dailyTitle}</h2>
          <p>{text.dailyNote}</p>
        </div>
        <a class="button primary" href={`/${locale}/daily/`}>
          {text.daily} ↗
        </a>
      </section>
      <AdSlot id="home-mid" locale={locale} />
      <section class="notes-grid">
        <article class="note-card">
          <span class="eyebrow">01 / {text.guides}</span>
          <h3>
            {label("Make the controller feel at home.", "패드로 더 편안하게.")}
          </h3>
          <p>
            {label(
              "One mapping, from the menu to the next round. See the current support boundaries.",
              "메뉴부터 다음 한 판까지 같은 조작. 현재 지원 범위를 확인하세요.",
            )}
          </p>
          <a href={`/${locale}/controller-games/`}>{text.controls} ↗</a>
        </article>
        <article class="note-card">
          <span class="eyebrow">02 / {text.compatibility}</span>
          <h3>
            {label("Big screen. Clear expectations.", "큰 화면, 분명한 안내.")}
          </h3>
          <p>
            {label(
              "Touch first. Parked only. Physical vehicle results are still pending.",
              "터치부터, 주차 중에만. 실차 결과는 아직 검증 전입니다.",
            )}
          </p>
          <a href={`/${locale}/tesla/`}>{text.compatibility} ↗</a>
        </article>
      </section>
    </>
  )}
  {game && kind === "games" && (
    <>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={`/${locale}/`}>{text.home}</a>
        <span>/</span>
        <a href={`/${locale}/category/${game.category}/`}>
          {text[game.category]}
        </a>
        <span>/ {game.text[locale].title}</span>
      </nav>
      <section class="detail-hero">
        <div>
          <span class="eyebrow">
            {text[game.category]} / {game.duration} {text.minutes}
          </span>
          <h1>{game.text[locale].title}</h1>
          <p>{game.text[locale].description}</p>
          <div class="detail-actions">
            <a class="button primary" href={`/${locale}/play/${game.id}/`}>
              {text.play} ↗
            </a>
            <button data-favorite={game.id} aria-pressed="false" type="button">
              ♡ {text.favorite}
            </button>
          </div>
          <div class="badges">
            <span class="badge">{text.touch}</span>
            <span class="badge">{text.keyboard}</span>
            <span class="badge">{text.pad}</span>
          </div>
        </div>
        <img
          src={game.artwork}
          width="640"
          height="400"
          alt={`${game.text[locale].title} — ${game.imported ? label("actual game preview", "실제 게임 화면") : label("original illustration", "게임 일러스트")}`}
        />
      </section>
      <div class="prose">
        {game.screenshot && (
          <figure class="game-screenshot">
            <img
              src={game.screenshot}
              width="640"
              height="640"
              loading="lazy"
              alt={`${game.text[locale].title} — ${label("actual game board", "실제 게임 화면")}`}
            />
            <figcaption>
              {label(
                "Actual game board · Chromium · 2026-10-11",
                "실제 게임 화면 · Chromium · 2026-10-11",
              )}
            </figcaption>
          </figure>
        )}
        <section>
          <h2>{text.rules}</h2>
          <ol>
            {game.text[locale].rules.map((rule) => (
              <li>{rule}</li>
            ))}
          </ol>
        </section>
        <section>
          <h2>{text.controls}</h2>
          <ul>
            {game.text[locale].controls.map((control) => (
              <li>{control}</li>
            ))}
          </ul>
        </section>
        <section>
          <h2>{text.tips}</h2>
          <ul>
            {game.text[locale].tips.map((tip) => (
              <li>{tip}</li>
            ))}
          </ul>
        </section>
        <section>
          <h2>{text.support}</h2>
          <p>{text.deviceNotice}</p>
          <p>
            <a href={`/${locale}/compatibility/`}>{text.compatibility}</a> ·{" "}
            <a href={`/${locale}/gamepad-test/`}>{text.gamepad}</a>
          </p>
        </section>
        <section>
          <h2>{text.credit}</h2>
          <p>
            {game.author} · {game.license}.{" "}
            {game.imported && (
              <a href="/licenses/crisp/">MIT notices / 출처 고지 · </a>
            )}
            <a href={game.source}>{text.source}</a>
          </p>
          <p>
            {label("Updated", "갱신일")}: {game.added}. {text.noAds}
          </p>
        </section>
        <AdSlot id="detail-body" locale={locale} />
      </div>
      <section>
        <div class="section-heading">
          <h2>{label("Next little escape", "다음 작은 즐거움")}</h2>
        </div>
        <div class="game-grid">
          {games
            .filter((g) => g.id !== game.id)
            .slice(0, 3)
            .map((g) => (
              <GameCard game={g} locale={locale} />
            ))}
        </div>
      </section>
    </>
  )}
  {game && isPlay && <Player game={game} locale={locale} />}
  {kind === "category" && (
    <>
      <div class="page-heading">
        <span class="eyebrow">
          {text.all} / {page}
        </span>
        <h1>{title}</h1>
        <p>
          {category === "puzzle"
            ? label(
                "A clear board, a fresh thought. Take all the time you need.",
                "선명한 보드, 새로운 생각. 천천히 풀어도 좋아요.",
              )
            : label(
                "A little motion. A good rhythm. Pick up and play.",
                "가벼운 움직임, 기분 좋은 리듬. 바로 시작하세요.",
              )}
        </p>
      </div>
      <div class="toolbar">
        <label>
          {text.sort}
          <select data-sort>
            <option value="recommended">{text.recommended}</option>
            <option value="name">{text.az}</option>
            <option value="newest">{text.newest}</option>
          </select>
        </label>
        <label>
          {text.filter}
          <select data-input-filter>
            <option value="any">{text.any}</option>
            <option value="touch">{text.touch}</option>
            <option value="keyboard">{text.keyboard}</option>
            <option value="gamepad">{text.pad}</option>
          </select>
        </label>
        <span class="count">
          {categoryGames(category!).length} {text.available}
        </span>
      </div>
      <div class="game-grid" data-sort-grid data-category={category}>
        {collection.map((g) => (
          <GameCard game={g} locale={locale} />
        ))}
      </div>
      {categoryGames(category!).length > PAGE_SIZE && (
        <nav
          class="pagination"
          data-pagination
          aria-label={label("Pages", "페이지")}
        >
          {Array.from(
            { length: Math.ceil(categoryGames(category!).length / PAGE_SIZE) },
            (_, i) => (
              <a
                href={`/${locale}/category/${category}${i ? "/page/" + (i + 1) : ""}/`}
                aria-current={page === i + 1 ? "page" : undefined}
              >
                {i + 1}
              </a>
            ),
          )}
        </nav>
      )}
      <AdSlot id="category-mid" locale={locale} />
    </>
  )}
  {kind === "daily" && (
    <>
      <div class="page-heading">
        <span class="eyebrow">{text.dailyLabel}</span>
        <h1>{text.dailyTitle}</h1>
        <p>{text.dailyText}</p>
        <p>
          <strong>
            {text.utc}: <time data-utc-date></time>
          </strong>
        </p>
      </div>
      <div class="game-grid">
        {games
          .filter((g) => g.tags.includes("daily"))
          .map((g) => (
            <article class="daily-card">
              <GameCard game={g} locale={locale} />
              <a
                class="button primary daily-play"
                data-daily={g.id}
                href={`/${locale}/play/${g.id}/?daily=1`}
              >
                {text.daily} ↗
              </a>
            </article>
          ))}
      </div>
      <p class="notice">{text.dailyNote}</p>
    </>
  )}
  {kind === "search" && (
    <>
      <div class="page-heading">
        <h1>{text.search}</h1>
      </div>
      <form class="search-form" id="search-form" role="search">
        <input
          id="search-query"
          name="q"
          type="search"
          aria-label={text.search}
          placeholder={text.search}
          maxlength="120"
        />
        <button type="submit">{text.searchAction}</button>
      </form>
      <p id="result-count" role="status"></p>
      <ul id="search-results" class="results-list"></ul>
      <p id="search-empty" hidden>
        {text.searchEmpty}
      </p>
    </>
  )}
  {kind === "library" && (
    <>
      <div class="page-heading">
        <span class="eyebrow">{label("JUST FOR YOU", "나만의 게임 선반")}</span>
        <h1>{text.library}</h1>
        <p>{text.continue}</p>
      </div>
      <h2 class="library-title">{text.favorites}</h2>
      <p data-library-empty="favorites" class="empty-state">
        {text.empty}
      </p>
      <div class="game-grid" data-library="favorites"></div>
      <h2 class="library-title">{text.recent}</h2>
      <p data-library-empty="recent" class="empty-state">
        {text.empty}
      </p>
      <div class="game-grid" data-library="recent"></div>
    </>
  )}
  {kind === "compatibility" && (
    <div class="prose">
      <div class="page-heading">
        <h1>{text.compatibility}</h1>
        <p>{text.deviceNotice}</p>
      </div>
      <table class="info-table">
        <thead>
          <tr>
            <th>{label("Environment", "환경")}</th>
            <th>{text.status}</th>
            <th>{label("Evidence", "근거")}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Chromium</td>
            <td>{label("Automated browser checks", "브라우저 자동화 검사")}</td>
            <td>
              {label(
                "See release record for the exact tested SHA.",
                "정확한 검증 SHA는 릴리스 기록을 확인하세요.",
              )}
            </td>
          </tr>
          <tr>
            <td>iOS Safari / Android Chrome</td>
            <td>{text.unverified}</td>
            <td>
              {label(
                "Responsive emulation is a separate check.",
                "반응형 에뮬레이션과 실기기는 다릅니다.",
              )}
            </td>
          </tr>
          <tr>
            <td>Xbox / DualSense</td>
            <td>{text.unverified}</td>
            <td>
              {label(
                "Standard mapping implemented; physical connection pending.",
                "표준 매핑 구현, 실제 연결 검증 전.",
              )}
            </td>
          </tr>
          <tr>
            <td>Tesla Ryzen / Atom</td>
            <td>{text.unverified}</td>
            <td>
              {label(
                "No physical vehicle results recorded.",
                "기록된 실차 결과가 없습니다.",
              )}
            </td>
          </tr>
        </tbody>
      </table>
      <h2>{label("What we record", "이렇게 기록합니다")}</h2>
      <p>
        {label(
          "Date, release SHA, OS/browser or vehicle firmware, input model and connection, then separate open/touch/controller/audio/save/resume outcomes. We never promote a synthetic result to physical verification.",
          "날짜·릴리스 SHA·OS와 브라우저 또는 차량 펌웨어·입력 장치와 연결 방식을 남깁니다. 열림·터치·패드·소리·저장·복귀는 각각 확인하며 가상 입력을 실기기 검증으로 표시하지 않습니다.",
        )}
      </p>
      <p>
        <a href="https://github.com/iamdenny/denny-games/tree/main/docs/releases">
          {label("Release evidence", "릴리스 검증 기록")} ↗
        </a>
      </p>
      <AdSlot id="guide-body" locale={locale} />
    </div>
  )}
  {kind === "gamepad-test" && (
    <div class="prose">
      <div class="page-heading">
        <h1>{text.gamepad}</h1>
        <p>
          {label(
            "Local, live input information. Nothing on this panel is uploaded.",
            "입력 정보를 이 화면에서만 확인합니다. 패널 내용은 업로드하지 않습니다.",
          )}
        </p>
      </div>
      <p class="notice">
        {label(
          "Connect a controller and press a button. HTTPS and browser support are required. Standard mapping is used; other mappings remain unverified.",
          "패드를 연결하고 버튼을 눌러보세요. HTTPS와 브라우저 지원이 필요합니다. 표준 매핑을 사용하며 다른 매핑은 미검증입니다.",
        )}
      </p>
      <pre id="diagnostic" class="diagnostic" aria-live="off"></pre>
      <button id="touch-test" class="touch-test" type="button">
        {label("Tap to test touch / click", "터치·클릭을 시험해보세요")}
      </button>
      <p id="touch-result" role="status"></p>
      <button id="diagnostic-sound" type="button">
        {label("Test sound", "소리 시험")}
      </button>
    </div>
  )}
  {kind === "guides" && path === "guides" && (
    <>
      <div class="page-heading">
        <span class="eyebrow">{text.guides}</span>
        <h1>{label("A smoother next round.", "다음 한 판은 더 편하게.")}</h1>
        <p>
          {label(
            "Simple notes on controls, sound and saving.",
            "조작·소리·저장을 위한 짧은 안내입니다.",
          )}
        </p>
      </div>
      <div class="notes-grid">
        {guidePaths.map((p, i) => (
          <article class="note-card">
            <span class="eyebrow">0{i + 1}</span>
            <h2>{articles[p]![locale].title}</h2>
            <p>{articles[p]![locale].intro}</p>
            <a href={`/${locale}/${p}/`}>{label("Read note", "노트 읽기")} ↗</a>
          </article>
        ))}
      </div>
    </>
  )}
  {article && (
    <article class="prose">
      <div class="page-heading">
        <span class="eyebrow">DENNY GAMES / {text.guides}</span>
        <h1>{article.title}</h1>
        <p>{article.intro}</p>
      </div>
      {article.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </section>
      ))}
      {path === "contact" && (
        <p>
          <a
            class="button primary"
            href="https://github.com/iamdenny/denny-games/issues/new"
          >
            GitHub ↗
          </a>
        </p>
      )}
      {["tesla", "controller-games"].includes(path) && (
        <p>
          <a class="button" href={`/${locale}/gamepad-test/`}>
            {text.gamepad} ↗
          </a>
        </p>
      )}
      {path.startsWith("guides/") && <AdSlot id="guide-body" locale={locale} />}
    </article>
  )}
  {kind === "licenses" && (
    <div class="prose">
      <div class="page-heading">
        <h1>{text.licenseTitle}</h1>
        <p>
          {label(
            "Game authors and license notices are part of the experience.",
            "제작자와 라이선스 고지를 함께 제공합니다.",
          )}
        </p>
      </div>
      {games.map((g) => (
        <section>
          <h2>{g.text[locale].title}</h2>
          <p>
            {g.author} · {g.license}
          </p>
          <p>
            <a href={g.source}>{text.source}</a>
            {g.imported && (
              <>
                <span> · </span>
                <a href="/licenses/crisp/">MIT notices / pinned sources</a>
              </>
            )}
            {g.id === "2048" && (
              <>
                {" "}
                · <a href="/licenses/2048.txt">MIT notice / upstream commit</a>
              </>
            )}
          </p>
        </section>
      ))}
      <p>
        <a href="https://github.com/iamdenny/denny-games/blob/main/LICENSE">
          Denny Games MIT
        </a>{" "}
        ·{" "}
        <a href="/licenses/dependencies.json">
          {label("Dependency notices", "의존성 라이선스")}
        </a>
      </p>
    </div>
  )}
</Base>

<script>
  if (document.querySelector("#search-query"))
    void import("../../scripts/search");
  if (document.querySelector("#diagnostic"))
    void import("../../scripts/diagnostic");
</script>
