          ·{" "}
          <a href={`/${locale}/guides/open-browser-games/`}>
            {label("Sources and save limits", "출처와 저장 제한")}
          </a>
        </p>
        {gameCollection.id === "daily-challenges" && (
          <p>
            <a class="button primary" href={`/${locale}/daily/`}>
              {text.daily} ↗
            </a>
          </p>
        )}
      </div>
      <p>
        <a href={`/${locale}/search/`}>
          {label("Search with more filters", "더 많은 조건으로 검색")} ↗
        </a>
      </p>
    </>
  )}
  {kind === "daily" && (
    <>
      <div class="page-heading">
        <span class="eyebrow">{text.dailyLabel}</span>
        <h1>{text.dailyTitle}</h1>
        <p>{text.dailyText}</p>
