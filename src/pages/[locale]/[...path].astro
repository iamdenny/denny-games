          <tr>
            <th>{label("Environment", "환경")}</th>
            <th>{text.status}</th>
            <th>{label("Evidence", "근거")}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Chromium</td>
            <td>{label("Automated browser checks", "브라우저 자동화 검사")}</td>
            <td>
              {label(
                "See release record for the exact tested SHA.",
                "정확한 검증 SHA는 릴리스 기록을 확인하세요.",
