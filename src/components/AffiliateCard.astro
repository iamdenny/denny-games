---
import type { Locale } from "../lib/types";
import { coupang, affiliateReady } from "../data/affiliate";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

{affiliateReady() && (
  <aside
    class="affiliate-card"
    data-affiliate="coupang"
    aria-label={
      locale === "ko" ? "쿠팡 파트너스 광고" : "Coupang affiliate advertisement"
    }
  >
    <small>
      {locale === "ko"
        ? "광고 · 쿠팡 파트너스"
        : "Advertisement · Coupang Partners"}
    </small>
    <h2>
      {locale === "ko"
        ? "게임패드로 플레이해 볼까요?"
        : "Looking for a gamepad?"}
    </h2>
    <p>
      {locale === "ko"
        ? "쿠팡에서 게임패드 검색 결과를 살펴보세요. 구매 전 사용하는 기기·브라우저·연결 방식과 반품 조건을 상품별로 확인하세요."
        : "Browse gamepad listings on Coupang, a Korean shopping service. Check each product’s device and browser compatibility, connection type, and return terms before buying."}
    </p>
    <p class="affiliate-disclosure">
      {locale === "ko"
        ? "이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다."
        : "As a Coupang Partners affiliate, we receive a commission on qualifying purchases made through this link."}
    </p>
    <a
      class="button"
      href={coupang.url}
      target="_blank"
      rel="sponsored nofollow noopener noreferrer"
    >
      {locale === "ko"
        ? "쿠팡에서 게임패드 보기 · 새 창"
        : "Browse gamepads on Coupang · new tab"}
    </a>
  </aside>
)}
<style>
  .affiliate-card {
    border: 1px solid var(--ink, #202720);
    border-radius: 12px;
    padding: clamp(18px, 3vw, 30px);
    margin-block: 28px;
    background: var(--paper, #f5f2e9);
    overflow-wrap: anywhere;
  }
  .affiliate-card small {
    display: block;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .affiliate-card h2 {
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    margin-block: 12px;
  }
  .affiliate-card p {
    max-width: 65ch;
  }
  .affiliate-disclosure {
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .affiliate-card a {
    max-width: 100%;
    white-space: normal;
    margin-top: 10px;
  }
</style>
