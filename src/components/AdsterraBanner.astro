---
import { adsterra } from "../data/adsterra";
import type { Locale } from "../lib/types";
interface Props {
  locale: Locale;
  categoryEligibility?: boolean;
  searchEligibility?: boolean;
}
const {
  locale,
  categoryEligibility = false,
  searchEligibility = false,
} = Astro.props;
const ko = locale === "ko";
---

{adsterra.enabled && adsterra.approved && adsterra.filtersConfirmed && (
  <aside
    id="advertising"
    class="adsterra-banner"
    data-adsterra
    data-adsterra-category={categoryEligibility ? "" : undefined}
    data-adsterra-search={searchEligibility ? "" : undefined}
    hidden={categoryEligibility || searchEligibility}
    aria-label={ko ? "광고 · Adsterra" : "Advertisement · Adsterra"}
  >
    <small>{ko ? "광고 · Adsterra" : "Advertisement · Adsterra"}</small>
    <p data-adsterra-declined hidden role="status">
      {ko
        ? "광고를 거절했습니다. 아래에서 언제든 바꿀 수 있어요."
        : "Ads declined. You can change this choice below."}
    </p>
    <div data-adsterra-choice>
      <p>
        {ko
          ? "광고를 허용하면 Adsterra와 광고 파트너가 IP·브라우저 정보를 받고 쿠키를 사용할 수 있어요. 거절해도 모든 게임을 이용할 수 있습니다."
          : "Allowing ads lets Adsterra and advertising partners receive your IP and browser information and use cookies. All games remain available if you decline."}
      </p>
      <a href={`/${locale}/privacy/`}>
        {ko ? "개인정보 안내" : "Privacy details"}
      </a>
      <button type="button" data-adsterra-allow>
        {ko ? "광고 허용" : "Allow ads"}
      </button>
      <button type="button" data-adsterra-deny>
        {ko ? "광고 거절" : "Decline ads"}
      </button>
    </div>
    <div class="adsterra-surface" data-adsterra-surface hidden></div>
    <p data-adsterra-status role="status" hidden>
      {ko
        ? "광고를 요청했습니다. 광고가 없거나 차단되면 빈 영역으로 남을 수 있습니다."
        : "Ad requested. This space may remain empty if no ad is available or it is blocked."}
    </p>
    <button type="button" data-adsterra-revoke hidden>
      {ko ? "광고 허용 취소" : "Withdraw ad consent"}
    </button>
  </aside>
)}
<style>
  .adsterra-banner {
    grid-column: 1 / -1;
    scroll-margin-top: 20px;
    margin: 32px 0;
    padding: 12px 0;
    border-block: 1px solid var(--line);
    text-align: center;
  }
  small {
    display: block;
    color: var(--muted);
  }
  p {
    max-width: 56ch;
    margin: 12px auto;
    font-size: 0.875rem;
  }
  button,
  a {
    margin: 4px;
  }
  .adsterra-surface {
    width: 300px;
    height: 250px;
    margin: 12px auto;
    max-width: 100%;
    overflow: hidden;
  }
  .adsterra-surface :global(iframe) {
    border: 0;
    width: 300px;
    height: 250px;
    display: block;
  }
</style>
<script>
  import { initAdsterra } from "../lib/adsterra";
  initAdsterra();
</script>
