---
import {
  collections,
  collectionGames,
  gameCollections,
} from "../data/collections";
import type { Locale } from "../lib/types";
const { locale, gameId } = Astro.props as { locale: Locale; gameId?: string };
const items = gameId ? gameCollections(gameId) : collections;
---

{items.length > 0 && (
  <section class="collection-links">
    <div class="section-heading">
      <h2>
        {locale === "ko" ? "플레이 방식별 게임 모음" : "Find your way to play"}
      </h2>
      {!gameId && (
        <a href={`/${locale}/collections/`}>
          {locale === "ko" ? "모음 전체 보기" : "All collections"} ↗
        </a>
      )}
    </div>
    <div class="collection-grid">
      {items.map((item) => {
        const games = collectionGames(item.id);
        return (
          <article
            class="game-card collection-card"
            data-collection-card={item.id}
          >
            <a
              class="game-card-link"
              href={`/${locale}/collections/${item.id}/`}
              aria-labelledby={`collection-title-${item.id}`}
            >
              <div class="collection-preview">
                {games.slice(0, 3).map((game) => (
                  <div
                    class={`card-art ${game.color} ${game.imported ? "imported-art" : ""}`}
                    data-preview-game={game.id}
                  >
                    <img
                      src={game.artwork}
                      width="640"
                      height="400"
                      alt={game.text[locale].title}
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
              <div class="card-copy">
                <span class="eyebrow">
                  {games.length} {locale === "ko" ? "개 게임" : "GAMES"}
                </span>
                <h3 id={`collection-title-${item.id}`}>
                  {item.text[locale].title} <span aria-hidden="true">↗</span>
                </h3>
                <p>{item.text[locale].intro}</p>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </section>
)}
