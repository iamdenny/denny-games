---
import { games, type Game } from "../data/games";
import { quickPlayGroups } from "../data/quick-play";
import { dailyGameIds } from "../lib/daily";
import { t } from "../data/i18n";
import type { Locale } from "../lib/types";
interface Props {
  game: Game;
  locale: Locale;
}
const { game, locale } = Astro.props;
const text = t(locale);
const localPicks = quickPlayGroups
  .flatMap((group) => group.ids)
  .map((id) => games.find((item) => item.id === id))
  .filter(
    (item): item is Game =>
      item !== undefined &&
      item.id !== game.id &&
      !item.externalPlay &&
      item.inputs.includes("touch"),
  );
const nextGame =
  localPicks.find((item) => item.category === game.category) ??
  localPicks[0] ??
  games.find(
    (item) =>
      item.id !== game.id &&
      !item.externalPlay &&
      item.inputs.includes("touch"),
  );
---

<section
  id="player"
  data-immersive="true"
  data-controls-layout={
    game.id === "crisp-chain-drift" ||
    game.id === "crisp-comet-slash" ||
    game.id === "crisp-volt-keeper"
      ? "side"
      : "bottom"
  }
  data-stage-ratio={
    game.id === "orbit-break"
      ? 640 / 680
      : game.id === "four-in-a-row"
        ? 7 / 6
        : 1
  }
  data-id={game.id}
  data-locale={locale}
  data-version={game.version}
  data-score-record={!game.classic && !game.internalScore ? "true" : "false"}
  data-daily-games={JSON.stringify(
    dailyGameIds
      .flatMap((id) =>
        games.filter(
          (item) =>
            item.id === id && item.tags.includes("daily") && !item.externalPlay,
        ),
      )
      .map((item) => ({
        id: item.id,
        version: item.version,
        title: item.text[locale].title,
      })),
  )}
  data-stages={game.stages}
  data-instructions={game.text[locale].controls[0]}
>
  <div class="player-top">
    <a class="exit-link" href={`/${locale}/games/${game.id}/`}>
      ← {text.exit}
    </a>
    <h1>{game.text[locale].title}</h1>
    <span
      id="stage-progress"
      class="stage-progress"
      aria-live="polite"
      hidden={game.stages < 2}
    ></span>
    <nav class="locale-nav" aria-label={locale === "ko" ? "언어" : "Language"}>
      {(["en", "ko"] as const).map((lang) => (
        <a
          data-locale-link
          href={`/${lang}/play/${game.id}/`}
          lang={lang}
          aria-current={locale === lang ? "page" : undefined}
        >
          {lang.toUpperCase()}
        </a>
      ))}
    </nav>
    <button id="fullscreen-button" type="button" aria-pressed="true">
      {locale === "ko" ? "기본 보기" : "Standard view"}
    </button>
  </div>
  <div class="play-area">
    <div id="game-host" aria-label={game.text[locale].title}></div>
    <div id="game-overlay" class="game-overlay">
      <div class="overlay-content">
        <span class="eyebrow">DENNY GAMES</span>
        <h2 id="overlay-title">{text.ready}</h2>
        <p id="overlay-note">{game.text[locale].controls[0]}</p>
        <p id="round-record" class="round-record" role="status" hidden></p>
        <p id="daily-result" role="status" hidden></p>
        <div id="game-mode-choice" hidden></div>
        <button id="start-button" type="button" class="button primary" disabled>
          {text.start} ↗
        </button>
        <button id="next-stage" type="button" class="button primary" hidden>
          {text.nextStage}
        </button>
        <button id="share-button" type="button" class="button" hidden>
          {text.share}
        </button>
        <a
          id="next-game"
          class="next-game"
          href={
            nextGame ? `/${locale}/play/${nextGame.id}/` : `/${locale}/all/`
          }
          hidden
        >
          {locale === "ko" ? "다음 한 판" : "Try next"}:{" "}
          {nextGame?.text[locale].title ??
            (locale === "ko" ? "게임 둘러보기" : "Explore games")}{" "}
          ↗
        </a>
        <textarea
          id="share-fallback"
          aria-label={text.copyResult}
          hidden
          readonly
        ></textarea>
        <p id="share-note" role="status"></p>
      </div>
    </div>
  </div>
  <p
    id="game-message"
    class="game-message"
    role="status"
    aria-live="polite"
  ></p>
  <div class="player-tools">
    <div class="scoreboard" hidden={game.internalScore}>
      <span>
        {text.score} <strong id="score">0</strong>
      </span>
      <span>
        {text.best} <strong id="best">0</strong>
      </span>
    </div>
    <div id="game-controls"></div>
    <div class="player-controls">
      <button id="pause-button" type="button" disabled>
        Ⅱ {text.pause}
      </button>
      <button id="restart-button" type="button" disabled>
        ↻ {text.restart}
      </button>
      <button id="sound-button" type="button" aria-pressed="false">
        ♪ {text.sound}: {text.off}
      </button>
      <details class="player-settings" id="player-settings">
        <summary>{locale === "ko" ? "설정" : "Settings"}</summary>
        <div class="settings-panel">
          <a href="#advertising">
            {locale === "ko"
              ? "광고 설정 · 자체 서비스"
              : "Ad settings · our services"}
          </a>
          <div id="game-settings"></div>
          <label class="sound-volume">
            {locale === "ko" ? "효과음 음량" : "Effects volume"}
            <input
              id="sound-volume"
              type="range"
              min="0"
              max="100"
              step="5"
              value="50"
            />
          </label>
          <label hidden={game.imported}>
            {text.stage}
            <select id="stage-select" aria-label={text.selectStage}>
              {Array.from({ length: game.stages }, (_, i) => (
                <option value={i + 1}>{i + 1}</option>
              ))}
            </select>
          </label>
          <label class="low-effects" hidden={game.imported}>
            <input id="low-effects" type="checkbox" />
            {text.low}
          </label>
          <p class="player-instructions">
            {game.text[locale].controls[1]}{" "}
            <span>
              {game.imported
                ? game.id === "hextris"
                  ? locale === "ko"
                    ? "진행 상태와 최고 기록은 이 브라우저에 저장되며 새로고침 후에도 이어집니다."
                    : "Your current game and high score stay in this browser and survive a reload."
                  : game.id === "sokoban"
                    ? locale === "ko"
                      ? "완료한 퍼즐은 이 브라우저에 저장됩니다. 진행 중인 퍼즐은 새로고침하면 처음부터 시작합니다."
                      : "Completed puzzles stay in this browser. An unfinished puzzle restarts after a reload."
                    : locale === "ko"
                      ? "페이지를 떠나면 라운드는 처음부터 시작합니다."
                      : "Leaving this page restarts the round."
                : text.continue}
            </span>
          </p>
        </div>
      </details>
    </div>
  </div>
</section>
<script>
  import "../scripts/player";
</script>
