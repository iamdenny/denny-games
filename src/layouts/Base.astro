---
import "../styles/global.css";
import { categories } from "../data/games";
import { t } from "../data/i18n";
import { ads } from "../data/ads";
import type { Locale } from "../lib/types";
interface Props {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  play?: boolean;
  root?: boolean;
  schema?: Record<string, unknown>;
  image?: string;
}
const {
  locale,
  title,
  description,
  path = "",
  noindex = false,
  play = false,
  root = false,
  schema,
  image = "/art/social.png",
} = Astro.props;
const text = t(locale),
  base = "https://games.iamdenny.com";
const route = root ? "/" : `/${locale}/${path ? path + "/" : ""}`;
const alternate = (lang: string) => `${base}/${lang}/${path ? path + "/" : ""}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <slot name="head" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title} · Denny Games</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noindex ? "noindex, follow" : "index, follow, max-image-preview:large"
      }
    />
    {root && (
      <meta name="msvalidate.01" content="017DFA330D27725009E6C34302CDFE7C" />
    )}
    {root && (
      <meta
        name="naver-site-verification"
        content="eea7cb463804b8f018a26e0ce7eb8b4c661a3ae5"
      />
    )}
    <meta name="theme-color" content="#f5f2e9" />
    <link rel="canonical" href={`${base}${route}`} />
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    <link rel="alternate" hreflang="ko" href={alternate("ko")} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={root || !path ? `${base}/` : alternate("en")}
    />
    <meta property="og:title" content={`${title} · Denny Games`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${base}${route}`} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}${image}`} />
    <meta property="og:site_name" content="Denny Games" />
    <meta property="og:locale" content={locale === "ko" ? "ko_KR" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Denny Games`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${base}${image}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
      />
    )}
    {ads.mode !== "off" && /^ca-pub-\d+$/.test(ads.publisher) && (
      <meta name="google-adsense-account" content={ads.publisher} />
    )}
  </head>
  <body
    data-locale={locale}
    class:list={{ "play-page": play, "player-immersive": play }}
  >
    <a class="skip-link" href="#main">
      {locale === "ko" ? "본문으로 건너뛰기" : "Skip to content"}
    </a>
    <header class="site-header">
      <a class="brand" href={`/${locale}/`}>
        <span class="brand-mark" aria-hidden="true">
          d<span>g</span>
        </span>
        <span>
          DENNY
          <br />
          GAMES<span class="brand-dot">.</span>
        </span>
      </a>
      {!play && (
        <details class="compact-menu">
          <summary>{locale === "ko" ? "메뉴" : "Menu"}</summary>
          <nav
            class="compact-menu-panel"
            aria-label={locale === "ko" ? "전체 메뉴" : "Site menu"}
          >
            <a href={`/${locale}/`}>{text.home}</a>
            <a href={`/${locale}/all/`}>{text.all}</a>
            <a href={`/${locale}/daily/`}>{text.daily}</a>
            <a href={`/${locale}/library/`}>{text.library}</a>
            {categories.map((category) => (
              <a href={`/${locale}/category/${category}/`}>{text[category]}</a>
            ))}
            <a href={`/${locale}/collections/`}>
              {locale === "ko" ? "게임 모음" : "Collections"}
            </a>
            <a href={`/${locale}/search/`}>{text.searchAction}</a>
            <a href={`/${locale}/compatibility/`}>{text.compatibility}</a>
            <a href={`/${locale}/gamepad-test/`}>{text.gamepad}</a>
            <a href={`/${locale}/guides/`}>{text.guides}</a>
          </nav>
        </details>
      )}
      <nav
        class="primary-nav"
        aria-label={locale === "ko" ? "주 메뉴" : "Main navigation"}
      >
        <a href={`/${locale}/`}>{text.home}</a>
        <a href={`/${locale}/all/`}>{text.all}</a>
        <a href={`/${locale}/daily/`}>{text.daily}</a>
        <a href={`/${locale}/library/`}>{text.library}</a>
      </nav>
      <div class="header-actions">
        <button
          data-large
          type="button"
          aria-pressed="false"
          title={text.large}
        >
          ▣ <span>{text.large}</span>
        </button>
        {!play && (
          <nav
            class="locale-nav"
            aria-label={locale === "ko" ? "언어" : "Language"}
          >
            <a
              data-locale-link
              href={`/en/${path ? path + "/" : ""}`}
              lang="en"
              aria-current={locale === "en" ? "page" : undefined}
            >
              EN
            </a>
            <a
              data-locale-link
              href={`/ko/${path ? path + "/" : ""}`}
              lang="ko"
              aria-current={locale === "ko" ? "page" : undefined}
            >
              KO
            </a>
          </nav>
        )}
      </div>
    </header>
    <aside
      class="analytics-consent"
      data-analytics-consent
      aria-label={locale === "ko" ? "분석 선택" : "Analytics choice"}
      hidden
    >
      <p data-analytics-consent-message>
        {locale === "ko"
          ? "방문 통계 개선을 위해 페이지 조회와 기본 브라우저 정보를 Google Analytics로 보낼 수 있어요. 검색어·입력값·게임 점수는 보내지 않으며 언제든 선택을 바꿀 수 있습니다."
          : "You can share page views and basic browser information with Google Analytics to improve Denny Games. Search terms, typed input and game scores are excluded. You can change this choice any time."}
        <a href={`/${locale}/privacy/`}>
          {locale === "ko" ? "개인정보 안내" : "Privacy details"}
        </a>
      </p>
      <div class="analytics-consent-actions">
        <button type="button" data-analytics-allow>
          {locale === "ko" ? "분석 허용" : "Allow analytics"}
        </button>
        <button type="button" data-analytics-deny>
          {locale === "ko" ? "거절" : "Decline"}
        </button>
      </div>
    </aside>
    <div class:list={["site-layout", { "play-layout": play }]}>
      {!play && (
        <aside class="sidebar">
          <p class="rail-label">
            {locale === "ko" ? "나만의 작은 오락실" : "YOUR LITTLE ARCADE"}
          </p>
          <nav aria-label={locale === "ko" ? "게임 탐색" : "Browse games"}>
            <a
              href={`/${locale}/all/`}
              aria-current={
                path === "all" || path.startsWith("all/") ? "page" : undefined
              }
            >
              ▦ <span>{text.all}</span>
            </a>
            {categories.map((category) => (
              <a href={`/${locale}/category/${category}/`}>
                {category === "puzzle" ? "◈" : "✳"}{" "}
                <span>{text[category]}</span>
              </a>
            ))}
            <a href={`/${locale}/collections/`}>
              ◉ <span>{locale === "ko" ? "게임 모음" : "Collections"}</span>
            </a>
            <a href={`/${locale}/search/`}>
              ⌕ <span>{text.searchAction}</span>
            </a>
          </nav>
          <div class="rail-divider"></div>
          <nav aria-label={text.guides}>
            <a href={`/${locale}/compatibility/`}>
              ↗ <span>{text.compatibility}</span>
            </a>
            <a href={`/${locale}/gamepad-test/`}>
              ⊕ <span>{text.gamepad}</span>
            </a>
            <a href={`/${locale}/guides/`}>
              ≡ <span>{text.guides}</span>
            </a>
          </nav>
          <p class="rail-note">
            {locale === "ko"
              ? "공개된 게임은 모두\n이 사이트 안에서 플레이해요."
              : "Every published game\nplays right here."}
          </p>
        </aside>
      )}
      <main id="main">
        <slot />
      </main>
    </div>
    {!play && (
      <footer class="site-footer">
        <a class="footer-brand" href={`/${locale}/`}>
          DENNY GAMES.
        </a>
        <p>{text.footer}</p>
        <nav aria-label={locale === "ko" ? "운영 정보" : "Site information"}>
          {(["about", "privacy", "terms", "contact", "licenses"] as const).map(
            (key) => (
              <a href={`/${locale}/${key}/`}>{text[key]}</a>
            ),
          )}
        </nav>
        <small>
          © {new Date().getUTCFullYear()} Denny Games · {text.noAds}
        </small>
      </footer>
    )}
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
