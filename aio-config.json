{
  "$schema": "./aio-config.schema.md",
  "base_branch": "main",
  "default_assignees": ["iamdenny"],
  "title_prefix": {
    "root": "DennyGames",
    "scope_rules": {}
  },
  "labels": {
    "user_based": {},
    "path_based": {},
    "special": []
  },
  "reviewers": {
    "default": [],
    "path_based": {}
  },
  "project_paths": {},
  "test_commands": {},
  "release_notes": {
    "format": "monolingual",
    "languages": ["ko"],
    "tag_pattern": "v*"
  },
  "wiki": {},
  "hooks": {},
  "qa": {
    "version": 1,
    "enabled": false,
    "scenarios_dir": "tests/qa",
    "docs_glob": ["docs/**/*.md", "README.md"],
    "environments": [],
    "artifacts": {
      "store": "gh-release-asset",
      "retention": { "passed": "7d", "failed": "30d", "flaky": "14d" },
      "video": "on-fail",
      "trace": "on-retry"
    },
    "policy": {
      "onFail": "warn",
      "onFlaky": "retry-once",
      "parallelism": 1,
      "scenarioParallelism": 1,
      "timeoutMinutes": 30
    }
  }
}
